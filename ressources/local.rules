# Règle du cours (section 3) : injection SQL de type UNION SELECT dans le module SQL Injection de DVWA
alert http any any -> $HOME_NET any (msg:"LAB DVWA - injection SQL UNION SELECT"; flow:established,to_server; http.uri; content:"/vulnerabilities/sqli/"; content:"union"; nocase; pcre:"/union(\s|\+|\/\*.*?\*\/)+select/i"; classtype:web-application-attack; sid:1000001; rev:1;)
# Q17 : ajoutez votre règle ci-dessous (sid:1000002)
